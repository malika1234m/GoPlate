// Plate3D — restaurant menu platform with 3D food models
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  // Null for accounts created with "Continue with Google" — they have no
  // password until they set one through the forgot-password flow.
  passwordHash         String?
  // Google's stable subject id. Set once the account is created with or
  // linked to Google; never reuse the email for this, Google can't change subs.
  googleId             String?              @unique
  name                 String
  plan                 String               @default("free") // free | pro
  tokenVersion         Int                  @default(0) // bump to revoke all existing sessions
  trialEndsAt          DateTime? // 30-day free trial; null = legacy account
  stripeCustomerId     String               @default("")
  stripeSubscriptionId String               @default("")
  createdAt            DateTime             @default(now())
  restaurants          Restaurant[]
  passwordResets       PasswordResetToken[]
  upgradeRequests      UpgradeRequest[]
  supportMessages      SupportMessage[]
}

/**
 * One-time "forgot password" link.
 * Only the SHA-256 of the token is stored — a leaked database row can't be
 * turned back into a working reset link. Rows are short-lived and are deleted
 * once used or superseded.
 */
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Order {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  tableNumber  String     @default("")
  customerName String     @default("")
  note         String     @default("")
  status       String     @default("NEW") // NEW | PREPARING | DONE | CANCELLED
  items        String // JSON snapshot: [{ name, quantity, unitPrice, options: [name], lineTotal }]
  total        Float
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

model Restaurant {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String     @default("")
  address     String     @default("")
  phone       String     @default("")
  currency    String     @default("USD")
  caption     String     @default("") // short tagline shown under the name on the menu
  logoUrl     String     @default("")
  coverUrl    String     @default("")
  accentColor String     @default("#F0762E")
  theme       String     @default("midnight") // midnight | espresso | ivory
  layout      String     @default("list") // list | grid
  showReel    Boolean    @default(true) // "From our kitchen" video reel on the menu
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  categories  Category[]
  items       MenuItem[]
  orders      Order[]
}

model Category {
  id            String     @id @default(cuid())
  name          String
  sortOrder     Int        @default(0)
  // Serving window as "HH:MM" (24h). Empty = served all day. Evaluated
  // against the customer's device clock — they are at the restaurant.
  availableFrom String     @default("")
  availableTo   String     @default("")
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId  String
  items         MenuItem[]
}

model MenuItem {
  id             String          @id @default(cuid())
  name           String
  caption        String          @default("") // short tasty one-liner shown under the dish name
  description    String          @default("")
  price          Float
  imageUrl       String          @default("")
  videoUrl       String          @default("")
  storyVideoUrl  String          @default("") // auto-edited "how it's made" clip
  modelUrl       String          @default("") // GLB file once 3D generation completes
  modelUsdzUrl   String          @default("") // USDZ for iOS AR Quick Look
  modelStatus    String          @default("NONE") // NONE | PROCESSING | READY | FAILED
  modelJobId     String          @default("")
  soldOutDate    String          @default("") // YYYY-MM-DD; sold out when it equals today
  isVegetarian   Boolean         @default(false)
  isSpicy        Boolean         @default(false)
  isAvailable    Boolean         @default(true)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId     String
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId   String
  modifierGroups ModifierGroup[]
}

// "Size", "Toppings", "Spice level" — choices a customer makes on a dish
model ModifierGroup {
  id        String           @id @default(cuid())
  name      String
  type      String           @default("single") // single | multi
  required  Boolean          @default(false)
  sortOrder Int              @default(0)
  item      MenuItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  options   ModifierOption[]
}

model ModifierOption {
  id         String        @id @default(cuid())
  name       String
  priceDelta Float         @default(0)
  sortOrder  Int           @default(0)
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId    String
}

/**
 * ============================ Back office ============================
 */

/**
 * Staff account for the admin console. Deliberately a separate table from
 * User rather than an `isAdmin` flag: owner tokens and admin tokens are then
 * issued from different records and carry different claims, so no bug in the
 * owner API can ever hand out back-office access. There is no public sign-up —
 * rows are created with `node prisma/create-admin.mjs`.
 */
model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  tokenVersion Int       @default(0) // bump to revoke every existing admin session
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  reviewedRequests UpgradeRequest[]
  handledMessages  SupportMessage[]
}

/**
 * An owner asking to move onto a paid plan while payment is still manual
 * (no gateway yet): they transfer the money and attach the slip, an admin
 * checks it and applies the plan.
 * `slipFile` is a bare filename, never a public /uploads URL — payment slips
 * carry bank details, and /uploads/[name] serves anything it is given without
 * asking who is calling. The file is readable only through the admin-only
 * slip route.
 */
model UpgradeRequest {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  requestedPlan String // basic | starter | pro
  amount        Float     @default(0) // what the owner says they paid
  currency      String    @default("USD")
  slipFile      String    @default("")
  note          String    @default("") // owner's message: reference number, bank, etc.
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote    String    @default("") // admin's reason, shown back to the owner
  reviewedAt    DateTime?
  reviewedBy    Admin?    @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById  String?
  createdAt     DateTime  @default(now())

  @@index([status])
  @@index([userId])
}

/**
 * "Something is wrong" from an owner, answered from the admin console.
 */
model SupportMessage {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  subject     String
  body        String
  status      String    @default("OPEN") // OPEN | RESOLVED
  reply       String    @default("")
  repliedAt   DateTime?
  handledBy   Admin?    @relation(fields: [handledById], references: [id], onDelete: SetNull)
  handledById String?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([userId])
}
